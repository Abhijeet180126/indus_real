# --- Company / Site Info (shown in navbar, footer, contact page & emails) ---
# COMPANY_NAME=Indus-Reality
# COMPANY_TAGLINE=Let's talk about your property plans
COMPANY_ADDRESS=Reji K, Real Estate Consultant, Kollam District, Kerala, India
COMPANY_PHONE=+91-9526615530
COMPANY_WHATSAPP=+91-9526615530
