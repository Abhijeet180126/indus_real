# Copy this file to .env and fill in real values. .env is gitignored.

# --- Django ---
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=

# --- Currency ---
# CURRENCY_SYMBOL=$

# --- Company / Site Info (shown in navbar, footer, contact page & emails) ---
# COMPANY_NAME=Indus-Reality
# COMPANY_TAGLINE=Let's talk about your property plans
# COMPANY_ADDRESS=123 Main Street, Your City
# COMPANY_PHONE=(555) 123-4567
# COMPANY_WHATSAPP=(555) 123-4567
# COMPANY_EMAIL=info@indusreality.example
# COMPANY_WEBSITE=https://www.indusreality.example

# --- Email: Amazon SES (set EMAIL_PROVIDER=ses to use this) ---
EMAIL_PROVIDER=ses
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_REGION_NAME=us-east-1
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
CONTACT_TO_EMAIL=client@example.com

# --- Email: SMTP (set EMAIL_PROVIDER=smtp to use this instead) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
